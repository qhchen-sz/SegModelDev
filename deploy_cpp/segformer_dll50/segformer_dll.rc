// segformer_dll.rc -- DLL 版本资源。
//
// 动态字段（编译日期/时间、编译机器名、版本号）由 segformer_dll.vcxproj 的
// GenerateBuildVersion 目标在每次编译前写入 $(IntDir)\build_version.h，
// 本文件只做引用。手工改版本信息请改工程里的宏，不要改 build_version.h。
//
// 版本号规则（与参考工程 gpu_Dll_func 一致）：
//   YYYY.M.D.50，最后一段 50 是 RTX 50 系列版本标识。
//
// 仅使用 ASCII 字符，避免 rc.exe 在中文代码页下的编码问题。

#include "winres.h"
#include "build_version.h"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION SEG_BUILD_VERSION_YEAR,SEG_BUILD_VERSION_MONTH,SEG_BUILD_VERSION_DAY,SEG_BUILD_VERSION_RTX
 PRODUCTVERSION SEG_BUILD_VERSION_YEAR,SEG_BUILD_VERSION_MONTH,SEG_BUILD_VERSION_DAY,SEG_BUILD_VERSION_RTX
 FILEFLAGSMASK 0x3fL
 FILEFLAGS SEG_BUILD_FILEFLAGS
 FILEOS 0x40004L
 FILETYPE 0x2L
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "ImageSource"
            VALUE "FileDescription", "SegFormer Segmentation Inference DLL (RTX 50, TensorRT 10.10, CUDA 12.9, cuDNN 9.11, OpenCV 4.8)"
            VALUE "FileVersion", SEG_BUILD_VERSION_STRING
            VALUE "InternalName", "segformer_Dll_func.dll"
            VALUE "LegalCopyright", "Copyright (C) 2026 ImageSource"
            VALUE "OriginalFilename", "segformer_Dll_func.dll"
            VALUE "ProductName", "SegFormer RTX50 Inference DLL"
            VALUE "ProductVersion", SEG_BUILD_VERSION_STRING
            VALUE "Comments", SEG_BUILD_COMMENTS
            VALUE "PrivateBuild", SEG_BUILD_MACHINE
            VALUE "BuildDate", SEG_BUILD_TIMESTAMP
            VALUE "BuildMachine", SEG_BUILD_MACHINE
            VALUE "Dependencies", "TensorRT 10.10 / CUDA 12.9 / cuDNN 9.11 / OpenCV 4.8"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
