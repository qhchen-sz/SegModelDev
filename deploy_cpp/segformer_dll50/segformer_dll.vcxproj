<?xml version="1.0" encoding="utf-8"?>
<!--
  segformer_dll.vcxproj —— SegFormer 语义分割 C++ DLL 的 RTX50 / TensorRT 10 工程。

  ★ 本工程是 ..\segformer_dll（TensorRT 8.6）的 RTX50 适配版，两处差异：
    1) 依赖切换到 TensorRT 10.10（lib 名改为 nvinfer_10.lib）；
    2) trt_engine.cpp 的 teardown() 用 delete 代替 TRT10 已移除的 destroy()。
    其它源码、C ABI、DLL 文件名（segformer_Dll_func.dll）完全不变，
    因此 C# 层 / 视觉软件无需任何改动。

  【输出】Release 的 DLL 直接生成在本目录（$(ProjectDir)）；
  Debug 生成到本目录的 Debug\ 子目录，避免误交付。中间文件在 obj\，
  不再写入 deploy_cpp\build\。

  【配置】Release|x64 与 Debug|x64。
  - Release：交付用。Optimization=MaxSpeed，运行时库 MultiThreadedDLL(/MD)。
  - Debug  ：调试用。Optimization=Disabled，运行时库 MultiThreadedDebugDLL(/MDd)。

  【换机器要改的三处】
  - TrtRoot      ：TensorRT 10.10 SDK 根目录（含 include\ 与 lib\）
  - OpenCvBuild  ：OpenCV build 目录（vc16）
  - CUDA         ：走 $(CUDA_PATH)；编译用 CUDA 12.x 头/库即可，
                   运行时必须是 CUDA 12.9 + cuDNN 9（见 run_seg_test.bat）
-->
<Project DefaultTargets="Build" ToolsVersion="15.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">

  <ItemGroup Label="ProjectConfigurations">
    <ProjectConfiguration Include="Debug|x64">
      <Configuration>Debug</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
    <ProjectConfiguration Include="Release|x64">
      <Configuration>Release</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
  </ItemGroup>

  <PropertyGroup Label="Globals">
    <ProjectGuid>{C3D4E5F6-A7B8-4C9D-8E1F-2A3B4C5D6E7F}</ProjectGuid>
    <RootNamespace>segformer_dll</RootNamespace>
    <Keyword>Win32Proj</Keyword>
    <WindowsTargetPlatformVersion>10.0</WindowsTargetPlatformVersion>
  </PropertyGroup>

  <!-- 依赖根目录。TrtRoot 必须是 TensorRT 10.x SDK（不是 E:\Tensorrt\TensorRT-8.6.1.6）；
       与 AIRTX50\gpu_Dll_func 使用同一个 10.10.0.31 安装目录。
       CUDA 走 $(CUDA_PATH) 环境变量。 -->
  <PropertyGroup Label="UserMacros">
    <TrtRoot>D:\Rtx50Test\TensorRT-10.10.0.31</TrtRoot>
    <OpenCvBuild>E:\opencv_exe\opencv\build</OpenCvBuild>
  </PropertyGroup>

  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.Default.props" />

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|x64'" Label="Configuration">
    <ConfigurationType>DynamicLibrary</ConfigurationType>
    <UseDebugLibraries>true</UseDebugLibraries>
    <PlatformToolset>v143</PlatformToolset>
    <CharacterSet>Unicode</CharacterSet>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|x64'" Label="Configuration">
    <ConfigurationType>DynamicLibrary</ConfigurationType>
    <UseDebugLibraries>false</UseDebugLibraries>
    <PlatformToolset>v143</PlatformToolset>
    <CharacterSet>Unicode</CharacterSet>
  </PropertyGroup>

  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.props" />
  <ImportGroup Label="ExtensionSettings" />
  <ImportGroup Label="PropertySheets" Condition="'$(Configuration)|$(Platform)'=='Debug|x64'">
    <Import Project="$(UserRootDir)\Microsoft.Cpp.$(Platform).user.props" Condition="exists('$(UserRootDir)\Microsoft.Cpp.$(Platform).user.props')" Label="LocalAppDataPlatform" />
  </ImportGroup>
  <ImportGroup Label="PropertySheets" Condition="'$(Configuration)|$(Platform)'=='Release|x64'">
    <Import Project="$(UserRootDir)\Microsoft.Cpp.$(Platform).user.props" Condition="exists('$(UserRootDir)\Microsoft.Cpp.$(Platform).user.props')" Label="LocalAppDataPlatform" />
  </ImportGroup>

  <!-- Release 直接输出到本目录（交付物就在 segformer_dll50\）；
       Debug 放 Debug\ 子目录，避免误把 Debug DLL 当 Release 交付。 -->
  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|x64'">
    <TargetName>segformer_Dll_func</TargetName>
    <OutDir>$(ProjectDir)Debug\</OutDir>
    <IntDir>$(ProjectDir)obj\$(Configuration)\</IntDir>
    <LinkIncremental>true</LinkIncremental>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|x64'">
    <TargetName>segformer_Dll_func</TargetName>
    <OutDir>$(ProjectDir)</OutDir>
    <IntDir>$(ProjectDir)obj\$(Configuration)\</IntDir>
    <LinkIncremental>false</LinkIncremental>
  </PropertyGroup>

  <ItemDefinitionGroup Condition="'$(Configuration)|$(Platform)'=='Debug|x64'">
    <ClCompile>
      <LanguageStandard>stdcpp17</LanguageStandard>
      <!-- 源码含中文注释，必须显式 /utf-8，否则 MSVC 按 GBK 解析会出 C4819 甚至乱码 -->
      <AdditionalOptions>/utf-8 %(AdditionalOptions)</AdditionalOptions>
      <WarningLevel>Level3</WarningLevel>
      <Optimization>Disabled</Optimization>
      <RuntimeLibrary>MultiThreadedDebugDLL</RuntimeLibrary>
      <ExceptionHandling>Sync</ExceptionHandling>
      <MultiProcessorCompilation>true</MultiProcessorCompilation>
      <PreprocessorDefinitions>NOMINMAX;WIN32_LEAN_AND_MEAN;SEGFORMER_DLL_EXPORTS;_WINDOWS;_USRDLL;_DEBUG;%(PreprocessorDefinitions)</PreprocessorDefinitions>
      <AdditionalIncludeDirectories>$(ProjectDir);$(TrtRoot)\include;$(CUDA_PATH)\include;$(OpenCvBuild)\include;%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
    </ClCompile>
    <Link>
      <SubSystem>Windows</SubSystem>
      <GenerateDebugInformation>true</GenerateDebugInformation>
      <AdditionalLibraryDirectories>$(TrtRoot)\lib;$(CUDA_PATH)\lib\x64;$(OpenCvBuild)\x64\vc16\lib;%(AdditionalLibraryDirectories)</AdditionalLibraryDirectories>
      <!-- Debug 必须链 OpenCV 的 **debug 库** opencv_world480d.lib：
           否则 _DEBUG 下 OpenCV 头把类型放进 cv::debug_build_guard 命名空间，
           与 Release 库的符号对不上 -> LNK2019(cv::resize 等)。运行时对应
           opencv_world480d.dll（在 build\x64\vc16\bin 下，run_seg_test.bat 的 PATH 已含该目录）。 -->
      <!-- TensorRT 10 的 import lib 带 _10 后缀；本 DLL 只用运行时 API，不链接 nvonnxparser -->
      <AdditionalDependencies>nvinfer_10.lib;cudart.lib;opencv_world480d.lib;%(AdditionalDependencies)</AdditionalDependencies>
    </Link>
  </ItemDefinitionGroup>

  <ItemDefinitionGroup Condition="'$(Configuration)|$(Platform)'=='Release|x64'">
    <ClCompile>
      <LanguageStandard>stdcpp17</LanguageStandard>
      <AdditionalOptions>/utf-8 %(AdditionalOptions)</AdditionalOptions>
      <WarningLevel>Level3</WarningLevel>
      <Optimization>MaxSpeed</Optimization>
      <RuntimeLibrary>MultiThreadedDLL</RuntimeLibrary>
      <ExceptionHandling>Sync</ExceptionHandling>
      <MultiProcessorCompilation>true</MultiProcessorCompilation>
      <PreprocessorDefinitions>NOMINMAX;WIN32_LEAN_AND_MEAN;SEGFORMER_DLL_EXPORTS;_WINDOWS;_USRDLL;NDEBUG;%(PreprocessorDefinitions)</PreprocessorDefinitions>
      <AdditionalIncludeDirectories>$(ProjectDir);$(TrtRoot)\include;$(CUDA_PATH)\include;$(OpenCvBuild)\include;%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
    </ClCompile>
    <Link>
      <SubSystem>Windows</SubSystem>
      <GenerateDebugInformation>true</GenerateDebugInformation>
      <AdditionalLibraryDirectories>$(TrtRoot)\lib;$(CUDA_PATH)\lib\x64;$(OpenCvBuild)\x64\vc16\lib;%(AdditionalLibraryDirectories)</AdditionalLibraryDirectories>
      <AdditionalDependencies>nvinfer_10.lib;cudart.lib;opencv_world480.lib;%(AdditionalDependencies)</AdditionalDependencies>
    </Link>
  </ItemDefinitionGroup>

  <!-- 推理内核改为本目录副本（自包含）；与 ..\src 下同名文件保持同步 -->
  <ItemGroup>
    <ClCompile Include="segformer_dll.cpp" />
    <ClCompile Include="trt_engine.cpp" />
    <ClCompile Include="seg_pipeline.cpp" />
  </ItemGroup>
  <ItemGroup>
    <ClInclude Include="segformer_dll.h" />
    <ClInclude Include="trt_engine.hpp" />
    <ClInclude Include="seg_pipeline.hpp" />
  </ItemGroup>

  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.targets" />
  <ImportGroup Label="ExtensionTargets" />
</Project>
